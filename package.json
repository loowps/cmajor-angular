{
  "name": "cmajor-angular",
  "version": "1.0.5",
  "scripts": {
    "ng": "ng",
    "start": "pnpm run dev",
    "dev": "ng build --watch --configuration development",
    "build": "ng build",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:coverage": "ng test --watch=false --coverage",
    "lint": "ng lint",
    "prepare": "husky",
    "prettier:check": "prettier --check \"**/*.{js,json,css,scss,md,ts,html,component.html}\"",
    "prettier": "prettier --write \"**/*.{js,json,css,scss,md,ts,html,component.html}\""
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.25.0",
  "private": true,
  "dependencies": {
    "@angular/common": "^21.0.5",
    "@angular/compiler": "^21.0.5",
    "@angular/core": "^21.0.5",
    "@angular/elements": "^21.0.5",
    "@angular/forms": "^21.0.5",
    "@angular/platform-browser": "^21.0.5",
    "@angular/platform-browser-dynamic": "^21.0.5",
    "@angular/router": "^21.0.5",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.3",
    "@angular/cli": "^21.0.3",
    "@angular/compiler-cli": "^21.0.5",
    "@eslint/js": "^9.39.2",
    "@vitest/coverage-v8": "^4.0.15",
    "angular-eslint": "^21.1.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^27.3.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.49.0",
    "vitest": "^4.0.15"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "msgpackr-extract",
      "lmdb",
      "unrs-resolver"
    ]
  }
}
